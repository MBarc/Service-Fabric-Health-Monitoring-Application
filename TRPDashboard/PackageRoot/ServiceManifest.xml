<?xml version="1.0" encoding="utf-8"?>
<ServiceManifest Name="TRPDashboardPkg"
                 Version="1.0.30"
                 xmlns="http://schemas.microsoft.com/2011/01/fabric"
                 xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<ServiceTypes>
		<!-- This is the name of your ServiceType. -->
		<StatelessServiceType ServiceTypeName="TRPDashboardType" />
	</ServiceTypes>

	<!-- Code package is your service executable. -->
	<CodePackage Name="Code" Version="1.0.30">
		<EntryPoint>
			<ExeHost>
				<Program>TRPDashboard.exe</Program>
				<WorkingFolder>CodePackage</WorkingFolder>
			</ExeHost>
		</EntryPoint>
		<EnvironmentVariables>
			<!-- Set when fronting the dashboard with the SF reverse proxy
			     (https://host:19081/HealthMonitoring/TRPDashboard/...). URL prefix emitted in links;
			     blank = derive from the service's own Fabric name (which is exactly the proxy path).
			     Blank also = direct access at https://host:8472/. -->
			<EnvironmentVariable Name="HealthMonitoring_PublicPathBase" Value="" />
		</EnvironmentVariables>
	</CodePackage>

	<!-- Config package removed since we're not using Settings.xml -->

	<Resources>
		<Endpoints>
			<!-- Internal HTTPS port. The dashboard is reached either directly (https://<node>:8472/)
           or through the SF reverse proxy (https://<lb>:19081/HealthMonitoring/TRPDashboard/...).
           Port 8472 (not 443) is dedicated to this app so it can run alongside the sibling apps
           (FabricShark 8470, FabricSight 8444) on a shared node without an http.sys binding
           collision, and so it never rebinds the node's shared 0.0.0.0:443 sslcert. SF binds the
           TLS cert to this port via EndpointBindingPolicy in ApplicationManifest. Build-And-Deploy
           -Unsecured rewrites this to Protocol="http" for an unsecured-cluster deploy. -->
			<Endpoint Name="ServiceEndpoint" Type="Input" Protocol="https" Port="8472" />
		</Endpoints>
	</Resources>
</ServiceManifest>